PORT=3000
NODE_ENV=development
# Set DATABASE_URL to switch from local SQLite to Supabase/PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
SQLITE_PATH=./ledgerly.sqlite
CORS_ORIGIN=http://localhost:5173,https://your-netlify-site.netlify.app
# Firebase Admin service account JSON. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT=
